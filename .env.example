# 复制成 .env 后填真值。.env 已进 .gitignore，不会上传 GitHub。
# 云上部署（Render/Railway/Fly）不要靠这个文件——把下面的值填进平台的 Environment 面板。

# ---- 必填：出图后端 ----
# mock=占位图（不花钱，验证链路用）/ apimart=云端图像大模型 / gemini / openai / comfy=本地
PROVIDER=apimart
APIMART_API_KEY=
APIMART_IMAGE_MODEL=gpt-image-2

# ---- 必填：安全（公网部署一定要改）----
DEPLOY=1                # 关掉"本机访问免管理员口令"，否则任何人都能调 /api/admin/*
ADMIN_TOKEN=            # 后台接口的备用口令，设一个长随机串
ADMIN_USER=admin
ADMIN_PASS=             # 后台登录密码（首次启动写库，之后以库里的为准）

# ---- 计费 ----
GEN_CREDITS=8           # 生成一次扣多少积分（10 积分 = 1 元）
FREE_GENS=3             # 注册送几次
USER_MAX_N=2            # 普通用户一次最多出几张
USD_CNY=7.15
RENDER_SIZE=768

# ---- 可选：自动到账支付（不填就是经营码人工确认）----
# 见后台 08 自动到账，或 backend/pay.py

# ---- 上线才需要（本地留空就行）----
# Supabase Postgres 连接串（用 6543 连接池地址）
DATABASE_URL=
# Supabase 对象存储：存顾客生成的图，不然 Render 重新部署一次图全没
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=weili
